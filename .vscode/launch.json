{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Artisan Serve (Laravel)",
      "type": "php",
      "request": "launch",
      "program": "${workspaceFolder}/laravel-app/artisan",
      "args": ["serve", "--port=8000"],
      "cwd": "${workspaceFolder}/laravel-app"
    },
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003
    }
  ]
}
