{
  "info": {
    "name": "Jajal Medical - Case Management API (Sanctum)",
    "description": "Complete collection for authenticating and managing medical implant cases using Laravel Sanctum.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jajalmedical.test\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "2. Login (Viewer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@jajalmedical.test\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "3. Logout (Revoke Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Medical Cases",
      "item": [
        {
          "name": "List Cases (Paginated + Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cases?page=1&status=Approved&search=Dr.",
              "host": ["{{base_url}}"],
              "path": ["cases"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "status", "value": "Approved" },
                { "key": "search", "value": "Dr." }
              ]
            }
          }
        },
        {
          "name": "Get Single Case",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cases/1",
              "host": ["{{base_url}}"],
              "path": ["cases", "1"]
            }
          }
        },
        {
          "name": "Create Case (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-0099\",\n  \"patient_reference\": \"PT-48201\",\n  \"surgeon_name\": \"Dr. Elena Rostova\",\n  \"implant_type\": \"Custom Titanium Cranial Mesh\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases",
              "host": ["{{base_url}}"],
              "path": ["cases"]
            }
          }
        },
        {
          "name": "Update Case (Admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-0099\",\n  \"patient_reference\": \"PT-48201\",\n  \"surgeon_name\": \"Dr. Elena Rostova\",\n  \"implant_type\": \"Custom Titanium Cranial Mesh\",\n  \"status\": \"Approved\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-22\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cases/1",
              "host": ["{{base_url}}"],
              "path": ["cases", "1"]
            }
          }
        },
        {
          "name": "Delete Case (Admin only - Viewer gets 403)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cases/1",
              "host": ["{{base_url}}"],
              "path": ["cases", "1"]
            }
          }
        }
      ]
    }
  ]
}
